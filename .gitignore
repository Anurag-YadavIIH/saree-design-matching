# Proprietary data: never commit
data/*
!data/.gitkeep

# Outputs (may contain image previews of proprietary data)
outputs/*
!outputs/.gitkeep
*.png
*.jpg
*.jpeg
*.pt
*.pth
*.ckpt

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.env

# README result charts: numbers only, generated by scripts/make_charts.py
!docs/img/
!docs/img/*.png
